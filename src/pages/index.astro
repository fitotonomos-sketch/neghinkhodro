---
import SiteLayout from '../layouts/SiteLayout.astro';
import VehicleCard from '../components/VehicleCard.astro';
import { vehicles } from '../data/vehicles.js';
const featuredVehicles = vehicles.filter((vehicle) => vehicle.featured).slice(0, 3);
const selectedVehicles = vehicles.filter((vehicle) => !vehicle.featured).slice(0, 3);
const categories = [
  { name: 'سدان لوکس', count: `${vehicles.filter((vehicle) => vehicle.category === 'سدان').length} خودرو`, symbol: 'S', query: 'سدان' },
  { name: 'شاسی‌بلند', count: `${vehicles.filter((vehicle) => vehicle.category === 'شاسی‌بلند').length} خودرو`, symbol: 'U', query: 'شاسی‌بلند' },
  { name: 'کوپه و اسپرت', count: `${vehicles.filter((vehicle) => vehicle.category === 'کوپه').length} خودرو`, symbol: 'C', query: 'کوپه' },
  { name: 'همه خودروها', count: `${vehicles.length} خودرو`, symbol: 'N', query: '' },
];
---
<SiteLayout title="نگین خودرو | انتخابی فراتر از انتظار" description="نمایشگاه تخصصی خودروهای لوکس و خاص در تهران؛ انتخابی مطمئن با همراهی مشاوران نگین خودرو.">
  <section class="hero" id="hero" aria-labelledby="hero-title">
    <img class="hero-image" data-site-asset="banner" src="https://cdn.b12.io/client_media/c93YGkzI/aa73ecc4-e3d2-11f1-b5aa-0242ac110002-realistic-premium-automotive-showroom-banner-photograph-for-.jpg" alt="خودروی لوکس در فضای اختصاصی نمایشگاه نگین خودرو" fetchpriority="high" width="1376" height="768" />
    <div class="container"><div class="hero-copy">
      <div class="eyebrow" data-copy="hero.eyebrow">NEGIN KHODRO · TEHRAN</div>
      <h1 id="hero-title" data-copy="hero.title">انتخابی فراتر از انتظار</h1>
      <p data-copy="hero.subtitle">مقصدی برای یافتن خودروهای ممتاز؛ با مشاوره‌ای صادقانه، کارشناسی دقیق و تجربه‌ای آرام از نخستین بازدید تا لحظه تحویل.</p>
      <a class="button" href="/vehicles/" data-copy="hero.button">مشاهده خودروهای موجود</a>
      <div class="hero-meta" aria-label="اطلاعات نمایشگاه"><div><strong data-copy="hero.experience">۱۵+</strong><span data-copy="hero.experience_label">سال تجربه</span></div><div><strong data-copy="hero.deliveries">۱۲۰۰</strong><span data-copy="hero.deliveries_label">تحویل موفق</span></div><div><strong data-copy="hero.satisfaction">۹۸٪</strong><span data-copy="hero.satisfaction_label">رضایت مشتریان</span></div></div>
    </div></div>
  </section>

  <section class="section" id="featured-vehicles" aria-labelledby="featured-title">
    <div class="container">
      <div class="section-heading"><div><div class="eyebrow">CURATED FOR YOU</div><h2 id="featured-title" data-copy="featured.title">منتخب نگین خودرو</h2><p data-copy="featured.intro">مدل‌هایی که از نگاه کارشناسان ما ارزش مکث کردن دارند.</p></div><a class="text-link" href="/vehicles/">مشاهده همه خودروها <span aria-hidden="true">←</span></a></div>
      <div class="vehicle-grid">{featuredVehicles.map((vehicle) => <VehicleCard vehicle={vehicle} featured />)}</div>
    </div>
  </section>

  <section class="section-tight" id="selected-vehicles" aria-labelledby="selected-title">
    <div class="container">
      <div class="section-heading"><div><div class="eyebrow">THE RIGHT CHOICE</div><h2 id="selected-title" data-copy="selected.title">پیشنهادهای ویژه</h2><p data-copy="selected.intro">گزیده‌ای از خودروهای آماده بازدید در شوروم.</p></div><a class="text-link" href="/vehicles/">تمام موجودی <span aria-hidden="true">←</span></a></div>
      <div class="vehicle-grid">{selectedVehicles.map((vehicle) => <VehicleCard vehicle={vehicle} />)}</div>
      <div class="center-action"><a class="button button-outline" href="/vehicles/">دیدن تمام خودروها <span aria-hidden="true">←</span></a></div>
    </div>
  </section>

  <section class="section" id="categories" aria-labelledby="categories-title">
    <div class="container">
      <div class="section-heading"><div><div class="eyebrow">FIND YOUR DRIVE</div><h2 id="categories-title" data-copy="categories.title">از کجا شروع کنیم؟</h2><p data-copy="categories.intro">دسته‌بندی دلخواهتان را انتخاب کنید و گزینه‌ها را ببینید.</p></div></div>
      <div class="categories" data-categories-grid>{categories.map((category) => <a class="category-tile" href={category.query ? `/vehicles/?category=${encodeURIComponent(category.query)}` : '/vehicles/'}><span><strong>{category.name}</strong><small>{category.count}</small></span><span class="category-symbol" aria-hidden="true">{category.symbol}</span></a>)}</div>
    </div>
  </section>
  <script>
    import { supabase } from '../lib/supabase'
    const categoryGrid = document.querySelector<HTMLElement>('[data-categories-grid]')
    if (supabase && categoryGrid) {
      const [{ data: categoryRows }, { data: inventoryRows }] = await Promise.all([
        supabase.from('categories').select('id,name,slug').order('sort_order').order('name'),
        supabase.from('vehicles').select('category_id').eq('status','available')
      ])
      if (categoryRows?.length && inventoryRows) {
        const counts = inventoryRows.reduce<Record<string, number>>((result, vehicle) => {
          if (vehicle.category_id) result[vehicle.category_id] = (result[vehicle.category_id] || 0) + 1
          return result
        }, {})
        categoryGrid.replaceChildren(...categoryRows.map((category, index) => {
          const link = document.createElement('a')
          link.className = 'category-tile'
          link.href = `/vehicles/?category=${encodeURIComponent(category.name)}`
          const text = document.createElement('span')
          const title = document.createElement('strong')
          title.textContent = category.name
          const count = document.createElement('small')
          count.textContent = `${new Intl.NumberFormat('fa-IR').format(counts[category.id] || 0)} خودروی موجود`
          text.append(title, count)
          const symbol = document.createElement('span')
          symbol.className = 'category-symbol'
          symbol.setAttribute('aria-hidden','true')
          symbol.textContent = ['S','U','C','N'][index % 4]
          link.append(text, symbol)
          return link
        }))
      }
    }
  </script>

  <section class="section intro-band" id="showroom-intro" aria-labelledby="intro-title">
    <div class="container intro-grid-inner">
      <div><div class="eyebrow">A DIFFERENT KIND OF SHOWROOM</div><h2 id="intro-title" data-copy="intro.title">خرید خودرو، با اطمینان خاطر.</h2></div>
      <div class="intro-copy"><p data-copy="intro.body">در نگین خودرو، انتخاب یک خودروی ممتاز فقط به دیدن چند تصویر و مقایسه قیمت خلاصه نمی‌شود. هر خودرو پیش از عرضه، با دقت بررسی می‌شود و مشاوران ما با شناخت نیاز شما، گزینه‌های مناسب را شفاف و بی‌اغراق معرفی می‌کنند. از نخستین گفت‌وگو تا کارشناسی، هماهنگی بازدید و تحویل، در کنار شما هستیم؛ تا انتخاب نهایی دقیقاً همان چیزی باشد که می‌خواهید.</p><div class="stats-inline"><div><strong data-copy="intro.experience">۴ مرحله</strong><span data-copy="intro.experience_label">فرآیند روشن خرید</span></div><div><strong data-copy="intro.deliveries">۳۶۰°</strong><span data-copy="intro.deliveries_label">بررسی پیش از عرضه</span></div><div><strong data-copy="intro.satisfaction">۱ همراه</strong><span data-copy="intro.satisfaction_label">از شروع تا تحویل</span></div></div></div>
    </div>
  </section>

  <section class="section" id="contact-inquiry" aria-labelledby="inquiry-title">
    <div class="container">
      <div class="contact-banner" id="contact-cta"><div><h2 data-copy="contact.title">برای انتخاب بعدی‌تان آماده‌اید؟</h2><p data-copy="contact.body">مشاوران نگین خودرو برای یک گفت‌وگوی کوتاه و بی‌تعهد در کنار شما هستند.</p></div><a class="button" href="tel:+982188714070" data-setting-href="contact.phone">تماس با مشاور <span dir="ltr" data-setting="contact.phone">۰۲۱ ۸۸۷۱ ۴۰۷۰</span></a></div>
      <div class="inquiry-wrap">
        <div class="inquiry-section"><h2 id="inquiry-title" data-copy="contact.inquiry_title">درخواست مشاوره</h2><p data-copy="contact.inquiry_intro">اطلاعاتتان را ثبت کنید تا در اولین فرصت با شما تماس بگیریم.</p>
          <form class="inquiry-form" data-form-id="803e8991-33c4-4d03-a877-1af5f4757557">
            <label><span data-copy="form.name">نام و نام خانوادگی</span> <span aria-hidden="true">*</span><input type="text" name="name" autocomplete="name" required /></label>
            <label><span data-copy="form.phone">شماره تماس</span> <span aria-hidden="true">*</span><input type="tel" name="phone" autocomplete="tel" inputmode="tel" required /></label>
            <label class="full-width">موضوع درخواست<select name="vehicle" required><option value="">انتخاب کنید</option><option>مشاوره خرید خودرو</option><option>مرسدس بنز E-Class</option><option>پورشه ماکان</option><option>BMW سری ۵</option></select></label>
            <label class="full-width"><span data-copy="form.message">پیام شما</span> <span aria-hidden="true">*</span><textarea name="message" required placeholder="زمان مناسب تماس یا توضیحات تکمیلی خود را بنویسید"></textarea></label>
            <button class="button full-width" type="submit"><span data-copy="form.submit">ارسال درخواست</span> <span aria-hidden="true">←</span></button>
          </form>
          <div class="form-help">ثبت درخواست به معنی تعهد برای خرید نیست. اطلاعات شما فقط برای پیگیری همین درخواست استفاده می‌شود.</div>
        </div>
        <div id="b12-form-done-803e8991-33c4-4d03-a877-1af5f4757557" class="admin-notice" hidden>درخواست شما با موفقیت ارسال شد. از اعتمادتان سپاسگزاریم.</div>
        <div id="b12-form-error-803e8991-33c4-4d03-a877-1af5f4757557" class="admin-notice" hidden>ارسال درخواست انجام نشد. لطفاً دوباره تلاش کنید یا با ما تماس بگیرید.</div>
      </div>
    </div>
  </section>
</SiteLayout>
