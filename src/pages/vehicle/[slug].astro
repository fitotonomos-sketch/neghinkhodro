---
import SiteLayout from '../../layouts/SiteLayout.astro';
import VehicleDetailRuntime from '../../components/VehicleDetailRuntime.astro';
import { getPublicVehicles } from '../../lib/public-vehicles';
import { renderVehicleDetailMarkup, renderVehicleJsonLd } from '../../lib/vehicle-markup';

export async function getStaticPaths() {
  const vehicles = await getPublicVehicles();
  return vehicles
    .filter((vehicle) => typeof vehicle.slug === 'string' && vehicle.slug.trim() && !vehicle.slug.includes('/') && !vehicle.slug.includes('\\'))
    .map((vehicle) => ({
      params: { slug: vehicle.slug },
      props: { vehicle, allVehicles: vehicles },
    }));
}

const { vehicle, allVehicles } = Astro.props;
const related = allVehicles
  .filter((item) => item.brand === vehicle.brand && item.slug !== vehicle.slug)
  .slice(0, 3);
const siteOrigin = (import.meta.env.PUBLIC_SITE_URL || 'https://neghinkhodro.com').replace(/\/$/, '');
const canonical = `${siteOrigin}/vehicle/${encodeURIComponent(vehicle.slug)}/`;
const vehicleTitle = [vehicle.name, vehicle.model].filter(Boolean).join(' ');
const pageTitle = `${vehicle.seo_title || vehicleTitle} | نگین خودرو`;
const description = String(
  vehicle.meta_description || vehicle.description || 'مشاهده مشخصات و جزئیات خودرو در نگین خودرو.'
).slice(0, 300);
const markup = renderVehicleDetailMarkup(vehicle, related);
const jsonLd = renderVehicleJsonLd(vehicle, canonical);
---

<SiteLayout
  title={pageTitle}
  description={description}
  canonical={canonical}
  ogImage={vehicle.image}
  ogType="product"
>
  <div
    id="vehicle-detail-root"
    data-vehicle-slug={vehicle.slug}
    data-has-initial="true"
    set:html={markup}
  ></div>
  <script type="application/ld+json" id="vehicle-jsonld" set:html={jsonLd}></script>
  <VehicleDetailRuntime />
</SiteLayout>
