---
import SiteLayout from '../../layouts/SiteLayout.astro';
import VehicleCard from '../../components/VehicleCard.astro';
import { getPublicVehicles, formatVehiclePrice } from '../../lib/public-vehicles';

export async function getStaticPaths() {
  const vehicles = await getPublicVehicles();

  return vehicles
    .filter((vehicle) => typeof vehicle.slug === 'string' && vehicle.slug.trim())
    .map((vehicle) => ({
      params: { slug: vehicle.slug },
      props: {
        vehicle,
        related: vehicles
          .filter((item) => item.brand === vehicle.brand && item.slug !== vehicle.slug)
          .slice(0, 3),
      },
    }));
}

const { vehicle, related } = Astro.props;

const specs = [
  ['برند', vehicle.brand],
  ['مدل', vehicle.model],
  ['سال ساخت', vehicle.year ? vehicle.year.toLocaleString('fa-IR') : '—'],
  ['کارکرد', `${vehicle.mileage.toLocaleString('fa-IR')} کیلومتر`],
  ['موتور', vehicle.engine],
  ['قدرت', vehicle.power],
  ['سوخت', vehicle.fuel],
  ['گیربکس', vehicle.transmission],
  ['محور محرک', vehicle.drivetrain],
  ['رنگ بدنه', vehicle.color],
  ['وضعیت', vehicle.status],
  ['دسته‌بندی', vehicle.category],
];
---
<SiteLayout title={`${vehicle.seo_title || `${vehicle.name} ${vehicle.model}`} | نگین خودرو`} description={vehicle.meta_description || vehicle.description}>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Vehicle',
    name: `${vehicle.name} ${vehicle.model}`,
    brand: { '@type': 'Brand', name: vehicle.brand },
    vehicleModelDate: String(vehicle.year || ''),
    image: vehicle.image,
    description: vehicle.description,
    mileageFromOdometer: { '@type': 'QuantitativeValue', value: vehicle.mileage, unitCode: 'KMT' },
    fuelType: vehicle.fuel,
    vehicleTransmission: vehicle.transmission,
    color: vehicle.color,
    vehicleConfiguration: vehicle.trim,
    category: vehicle.category,
  })}></script>
  <section class="page-hero" id="vehicle-overview" aria-labelledby="vehicle-title"><div class="container"><div class="breadcrumbs"><a href="/">خانه</a> / <a href="/vehicles/">خودروها</a> / {vehicle.name}</div><div class="page-heading"><div class="eyebrow">VEHICLE DETAILS · {vehicle.year}</div><h1 id="vehicle-title">{vehicle.name} {vehicle.model}</h1><p>{vehicle.trim}</p></div></div></section>
  <section class="section" id="vehicle-details" aria-labelledby="vehicle-title"><div class="container detail-grid">
    <div>
      <div class="detail-photo"><img src={vehicle.image} alt={vehicle.image_alt || `${vehicle.name} ${vehicle.model}، نمای بیرونی ${vehicle.color}`} width="1264" height="848" fetchpriority="high" decoding="async" /></div>
      {vehicle.gallery.length > 0 && <div class="vehicle-gallery" aria-label="گالری تصاویر خودرو">{vehicle.gallery.map((image, index) => <a href={image} target="_blank" rel="noopener noreferrer"><img src={image} alt={`${vehicle.name}، تصویر ${index + 1}`} loading="lazy" /></a>)}</div>}
      <section class="section-tight" id="vehicle-specifications" aria-labelledby="specifications-title"><div class="section-heading"><div><div class="eyebrow">SPECIFICATIONS</div><h2 id="specifications-title">مشخصات خودرو</h2></div></div><div class="spec-table">{specs.map(([label, value]) => <div class="spec-item"><span>{label}</span><strong>{value}</strong></div>)}</div></section>
      <section class="content-block" id="vehicle-description" aria-labelledby="description-title"><h2 id="description-title">درباره این خودرو</h2><p>{vehicle.description}</p><p>برای دریافت گزارش کارشناسی، هماهنگی بازدید یا آگاهی از جزئیات بیشتر، با مشاوران نگین خودرو در ارتباط باشید.</p>
      {vehicle.technical_specs.length > 0 && <div class="spec-table">{vehicle.technical_specs.map((item) => <div class="spec-item"><span>{item.key}</span><strong>{item.value}</strong></div>)}</div>}
      </section>
    </div>
    <aside class="detail-summary" aria-label="خلاصه خودرو">
      <h2>{vehicle.name}</h2><p class="detail-trim">{vehicle.trim} · {vehicle.year.toLocaleString('fa-IR')}</p>
      <div class="detail-price">{formatVehiclePrice(vehicle.price, vehicle.price_visible)} {vehicle.price_visible && vehicle.price > 0 && <small>تومان</small>}</div>
      <div class="summary-stat"><span>کارکرد</span><strong>{vehicle.mileage.toLocaleString('fa-IR')} کیلومتر</strong></div>
      <div class="summary-stat"><span>وضعیت فروش</span><strong>{vehicle.status}</strong></div>
      <a class="button" href="/#contact-inquiry">درخواست مشاوره و بازدید <span aria-hidden="true">←</span></a>
      <a class="button button-outline" href="/contact/" data-setting-href="contact.whatsapp" target="_blank" rel="noopener noreferrer">گفت‌وگو در واتس‌اپ</a>
      <p class="form-help">قیمت نهایی و شرایط معامله را با مشاور فروش هماهنگ کنید.</p>
    </aside>
  </div></section>
  {related.length > 0 && <section class="section" id="related-vehicles" aria-labelledby="related-title"><div class="container"><div class="section-heading"><div><div class="eyebrow">YOU MAY ALSO LIKE</div><h2 id="related-title">خودروهای مشابه</h2></div><a class="text-link" href="/vehicles/">مشاهده همه <span aria-hidden="true">←</span></a></div><div class="vehicle-grid">{related.map((item) => <VehicleCard vehicle={item} />)}</div></div></section>}
</SiteLayout>
