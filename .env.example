# Required before running npm run build.
# Use your final domain, without a trailing slash.
PUBLIC_SITE_URL=https://YOUR-DOMAIN.COM

# Supabase project URL and PUBLIC anon/publishable key.
# Never put the service_role/secret key in a PUBLIC_ variable.
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
