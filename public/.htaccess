DirectoryIndex index.html
RewriteEngine On

# Keep private PHP configuration files inaccessible from the web.
RewriteRule ^_private(?:/|$) - [F,L]

# Generate a live sitemap from the current public Supabase inventory.
# If this .htaccess rule is not processed, the prebuilt sitemap.xml remains available.
RewriteRule ^sitemap\.xml$ sitemap.php [L,QSA]

# All vehicle detail URLs use the PHP bridge so SEO metadata stays current after edits.
# Astro also pre-renders existing slugs as a fallback when rewrite support is unavailable.
RewriteRule ^vehicle/([^/]+)/?$ vehicle.php [L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>
